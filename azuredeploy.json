{
    "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "_artifactsLocationSasToken": {
            "type": "securestring",
            "defaultValue": "",
            "metadata": {
                "description": "SAS token for private template storage, if used."
            }
        },
        "rgName": {
            "type": "string",
            "metadata": {
                "description": "Name of an existing resource group. This template does not create a resource group."
            }
        },
        "location": {
            "type": "string"
        },
        "deployLighthouse": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "When true, deploys Azure Lighthouse registration for the resource group (BlueVoyant MSSP onboarding)."
            }
        },
        "deployGdapPermissions": {
            "type": "bool",
            "defaultValue": false,
            "metadata": {
                "description": "When true, deploys Azure RBAC role assignments from gdap-permissions.json on the resource group. (GDAP is configured in Partner Center / Entra, not by ARM; this template is IAM on the RG only.)"
            }
        },
        "_artifactsLocation": {
            "type": "string",
            "defaultValue": "https://raw.githubusercontent.com/steveienciu/moresentinel/main/"
        }
    },
    "variables": {
        "lighthouseTemplateUri": "[concat(parameters('_artifactsLocation'), 'lighthouse/bv_sentinel_lighthouse_template_rg.json', parameters('_artifactsLocationSasToken'))]",
        "gdapPermissionsTemplateUri": "[concat(parameters('_artifactsLocation'), 'gdap-permissions.json', parameters('_artifactsLocationSasToken'))]"
    },
    "resources": [
        {
            "condition": "[parameters('deployLighthouse')]",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2022-09-01",
            "name": "lighthouseDeployment",
            "location": "[parameters('location')]",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[variables('lighthouseTemplateUri')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "rgName": { "value": "[parameters('rgName')]" },
                    "mspOfferName": { "value": "BlueVoyant Azure Sentinel MSSP" },
                    "mspOfferDescription": { "value": "BlueVoyant Managed Security Services" },
                    "managedByTenantId": { "value": "172f0077-e962-407c-86e2-20b3cd881b2c" },
                    "authorizations": {
                        "value": [
                            {
                                "principalId": "35d106a1-c847-4b39-8cf2-0c0358a1d89b",
                                "principalIdDisplayName": "BlueVoyant SOC Analysts",
                                "roleDefinitionId": "3e150937-b8fe-4cfb-8069-0eaf05ecd056"
                            },
                            {
                                "principalId": "9088d8a2-760c-484c-8753-8f787c970121",
                                "principalIdDisplayName": "BlueVoyant SOC Engineering",
                                "roleDefinitionId": "b24988ac-6180-42a0-ab88-20f7382dd24c"
                            },
                            {
                                "principalId": "8aabcc7b-27bb-49fa-bcf7-e5f2e8a2e444",
                                "principalIdDisplayName": "BlueVoyant Client Success Team",
                                "roleDefinitionId": "8d289c81-5878-46d4-8554-54e1e3d8b5cb"
                            },
                            {
                                "principalId": "47464d21-730e-45b0-b230-8124d48b9949",
                                "principalIdDisplayName": "BlueVoyant Sentinel Automation Rules Engineering",
                                "roleDefinitionId": "f4c81013-99ee-4d62-a7ee-b3f1f648599a"
                            },
                            {
                                "principalId": "9088d8a2-760c-484c-8753-8f787c970121",
                                "principalIdDisplayName": "BlueVoyant MSP Operators",
                                "roleDefinitionId": "91c1777a-f3dc-4fae-b103-61d183457e46"
                            }
                        ]
                    }
                }
            }
        },
        {
            "condition": "[parameters('deployGdapPermissions')]",
            "name": "gdapPermissionsDeployment",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2023-07-01",
            "resourceGroup": "[parameters('rgName')]",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[variables('gdapPermissionsTemplateUri')]",
                    "contentVersion": "1.0.0.0"
                }
            }
        }
    ],
    "outputs": {
        "resourceGroupName": { "type": "string", "value": "[parameters('rgName')]" },
        "lighthouseDeployed": { "type": "string", "value": "[string(parameters('deployLighthouse'))]" },
        "gdapPermissionsTemplateDeployed": { "type": "string", "value": "[string(parameters('deployGdapPermissions'))]" }
    }
}
